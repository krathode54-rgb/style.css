body {
    margin: 0;
    font-family: Arial;
    text-align: center;
}
header {
    background: red;
    color: brown;
    padding: 20px;
}
nav a {
    color: greenyellow;
    margin: 15px;
    text-decoration: none;
    font-size: 18px;
}
.hero {
    background-image: url("food.jpg");
    background-size: cover;
    color: orangered;
    padding: 120px;
}
.hero button{
    padding: 10px 20px;
    font-size: 18px;
    background: whitesmoke;
    color: blue;
    border: none;
    cursor: pointer;
}
.menu {
    padding: 40px;
    background: peru;
}
.item {
    margin: 20px;
    padding: 20px;
    border: 1px solid #ddd;
}
.about {
    padding: 40px;
}
footer{
    background: violet;
    color: wheat;
    padding: 20px;
}
