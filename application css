* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}
body {
    background-color: blueviolet;
    display: flex;
    justify-content: center;
    min-height: 100vh;
    overflow: hidden;
}
.background-circles .circle {
    position: relative;
    border-radius: 50%;
    filter: blur(50px);
    z-index: -1;
}
.circle-1 {
    width:300px;
    height: 300px;
    background: linear-gradient(#00d2ff, #3a7bd5);
    top: 10%;
    left: 20%;
  animation: move 10s infinite alternate;
}
.circle-2 {
    width: 250px;
    height: 250px;
    background: linear-gradient(#ff512f, #dd2476);
    bottom: 10%;
    right: 20%;
    animation: move 15s infinite alternate-reverse;
}
@keyframes move {
    from {transform: translate(0,0);}
}
.glass-form {
    background: rgba(255,255,255,0.05);
    padding: 40px;
    border-radius: 20px;
    width: 400px;
    box-shadow: 0 25px 25px rgba(0,0,0,0.3);
    color: azure;
    animation: fadeIn 1s ease-out;
}
@keyframes fadeIn {
    from {opacity: 0; transform:translateY(20px);}
    to{opacity: 1; transform: translateY(0);}
}
h2 {
    margin-bottom: 20px;
    text-align: center;
}
p {
    text-align: center;
    font-size: 0.9rem;
    color: #94a3b8;
    margin-bottom: 30px;
}
.input-group {
margin-bottom: 20px;
}
label {
    display: block;
    margin-bottom: 8px;
    font-size: 0.85rem;
    font-weight: 500;
}
input,select,textarea {
    width: 100%;
    padding: 12px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 8px;
    color: white;
    outline: none;
    transition: 0.3s;
}
input.focus, select:focus, textarea:focus {
    border-color: #00d2ff;
    background: rgba(255,255,255,0.2);
}
.submit-btn {
    width: 100%;
    padding: 12px;
    background: #3a7bd5;
    border: none;
    border-radius: 8px;
    color: wheat;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
    margin-top: 10px;
}
.submit-btn:hover {
    background: #00d2ff;
    transform: scale(1.02);
}
